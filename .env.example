# Application environment classification.
# Existing local/Vercel DEVELOPMENT may omit this and safely defaults to development.
# STAGING/PRODUCTION must set it explicitly.
KDKMP_APP_ENV=development

# Pin the expected Supabase project ref.
# Required for STAGING/PRODUCTION so a deployment cannot silently use the wrong database.
# Example format only: abcdefghijklmnopqrst
KDKMP_EXPECTED_SUPABASE_REF=

# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential used only by trusted server routes.
# Never expose this value through NEXT_PUBLIC_* variables or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider credentials. Keep unset until the provider/commercial gate is authorized.
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
